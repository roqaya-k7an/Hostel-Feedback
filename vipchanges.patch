From fd926641585b9257a389ceedb3d171782e836596 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 25 Jun 2026 22:44:57 +0000
Subject: [PATCH 1/6] Add Verify Details button for manual auto-fill of
 resident information

- New /api/lookup-resident endpoint for resident lookup by student_id
- Modified student login form: only email and registration number required
- Added 'Verify Details' button that fetches and auto-fills resident info
- Auto-filled fields (Full Name, Room, Block, Academic Level) are read-only
- Only registered students can proceed with feedback
- Updated /api/verify endpoint to require roster match

Co-Authored-By: roqaya-k7an <153377899+roqaya-k7an@users.noreply.github.com>
---
 app.py                 | 44 +++++++++++++++++++++++++++--------
 static/js/student.js   | 52 +++++++++++++++++++++++++++++++++++++++++-
 templates/student.html | 45 ++++++++++++++++--------------------
 3 files changed, 106 insertions(+), 35 deletions(-)

diff --git a/app.py b/app.py
index 9a383bd..d5b5433 100644
--- a/app.py
+++ b/app.py
@@ -64,6 +64,32 @@ def student_flow():
 # ---------------------------------------------------------------------------
 # Student API
 # ---------------------------------------------------------------------------
+@app.route("/api/lookup-resident", methods=["POST"])
+def api_lookup_resident():
+    """Lookup resident by student ID only (for auto-fill)."""
+    data = request.get_json(force=True)
+    student_id = (data.get("student_id") or "").strip()
+
+    if not student_id:
+        return jsonify({"ok": False, "error": "missing_student_id"}), 400
+
+    with database.get_db() as conn:
+        row = conn.execute(
+            "SELECT * FROM residents WHERE LOWER(TRIM(student_id)) = LOWER(TRIM(?))",
+            (student_id,),
+        ).fetchone()
+
+    if row:
+        resident = dict(row)
+        return jsonify({"ok": True, "resident": {
+            "full_name": resident.get("full_name"),
+            "room_number": resident.get("room_number"),
+            "block": resident.get("block"),
+            "academic_level": resident.get("academic_level"),
+        }})
+    return jsonify({"ok": False, "error": "not_found"}), 404
+
+
 @app.route("/api/verify", methods=["POST"])
 def api_verify():
     """Verify Student ID + Email against roster, and check for duplicates."""
@@ -78,15 +104,15 @@ def api_verify():
         return jsonify({"ok": False, "reason": "duplicate"})
 
     resident = database.find_resident(student_id, email)
-    if resident:
-        return jsonify({"ok": True, "matched": True, "resident": {
-            "full_name": resident.get("full_name"),
-            "room_number": resident.get("room_number"),
-            "block": resident.get("block"),
-            "academic_level": resident.get("academic_level"),
-        }})
-    # No match still allowed to continue (but flagged)
-    return jsonify({"ok": True, "matched": False})
+    if not resident:
+        return jsonify({"ok": False, "reason": "not_in_roster"})
+
+    return jsonify({"ok": True, "matched": True, "resident": {
+        "full_name": resident.get("full_name"),
+        "room_number": resident.get("room_number"),
+        "block": resident.get("block"),
+        "academic_level": resident.get("academic_level"),
+    }})
 
 
 @app.route("/api/submit", methods=["POST"])
