     linear-gradient(160deg, var(--navy-deep), var(--navy));
   color: #fff; display: flex; flex-direction: column;
 }
+/* Hero background photo layer with gradient overlay for readability */
+.hero::before {
+  content: ""; position: absolute; inset: 0; z-index: 0;
+  background-image: url("https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1920&q=80");
+  background-size: cover; background-position: center;
+  opacity: .22; filter: saturate(115%);
+}
+.hero::after {
+  content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
+  background: linear-gradient(160deg, rgba(28,14,58,.55) 0%, rgba(42,18,87,.35) 45%, rgba(58,30,114,.55) 100%);
+}
+.hero > .container, .hero__body { position: relative; z-index: 1; }
 .hero__nav { display: flex; align-items: center; justify-content: space-between; padding: 24px 0; }
 .hero .brand, .hero .brand__logo { color: #fff; }
 .hero__body { flex: 1; display: flex; align-items: center; }
@@ -150,13 +162,29 @@ html[dir="rtl"] .page-back:hover { transform: translateX(3px); }
 .hero__note { margin-top: 28px; font-size: .9rem; color: rgba(255,255,255,.6); display: flex; gap: 18px; flex-wrap: wrap; }
 .hero__note span { display: inline-flex; align-items: center; gap: 7px; }
 .hero__art {
-  background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12);
-  border-radius: 20px; padding: 26px; backdrop-filter: blur(6px);
+  background: rgba(255,255,255,.08);
+  border: 1px solid rgba(255,255,255,.22);
+  border-radius: 24px; padding: 28px;
+  backdrop-filter: blur(18px) saturate(150%);
+  -webkit-backdrop-filter: blur(18px) saturate(150%);
+  box-shadow: 0 18px 50px rgba(20,8,45,.45), inset 0 1px 0 rgba(255,255,255,.25);
+  position: relative; overflow: hidden;
+}
+/* glossy sheen across the glass panel */
+.hero__art::before {
+  content: ""; position: absolute; top: 0; left: -40%; width: 60%; height: 100%;
+  background: linear-gradient(115deg, transparent, rgba(255,255,255,.18), transparent);
+  transform: skewX(-18deg); pointer-events: none;
 }
 .hero__art-row { display: flex; gap: 14px; margin-bottom: 14px; }
-.mini-kpi { flex: 1; background: rgba(255,255,255,.08); border-radius: 12px; padding: 16px; }
+.mini-kpi {
+  flex: 1; border-radius: 14px; padding: 16px;
+  background: rgba(255,255,255,.10);
+  border: 1px solid rgba(255,255,255,.14);
+  backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
+}
 .mini-kpi b { font-size: 1.6rem; color: #fff; font-family: var(--serif); display: block; }
-.mini-kpi span { font-size: .78rem; color: rgba(255,255,255,.65); }
+.mini-kpi span { font-size: .78rem; color: rgba(255,255,255,.7); }
 .mini-bars { display: flex; align-items: flex-end; gap: 8px; height: 90px; padding-top: 10px; }
 .mini-bars i { flex: 1; background: linear-gradient(var(--teal), var(--gold)); border-radius: 5px 5px 0 0; display: block; }
 
