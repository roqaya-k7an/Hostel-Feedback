+def resident_exists(student_id):
+    """True if the roster contains this Registration Number (any email)."""
+    with get_db() as conn:
+        row = conn.execute(
+            "SELECT 1 FROM residents WHERE LOWER(TRIM(student_id)) = LOWER(TRIM(?)) LIMIT 1",
+            (student_id,),
+        ).fetchone()
+    return row is not None
+
